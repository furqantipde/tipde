# Public site URL used for canonical tags and the sitemap.
VITE_SITE_URL=https://tipde.online

# Leave blank until GA4 is configured. Analytics loads only after consent.
VITE_GA_MEASUREMENT_ID=

# Optional Search Console verification code (without the meta tag wrapper).
VITE_GSC_VERIFICATION=

# Set to true only when real ad code is ready. Never enable fake ads.
VITE_ENABLE_ADS=false

# Contact address shown on the Contact page.
VITE_CONTACT_EMAIL=hello@tipde.online

# Asset base path. /tipde/ is required for the github.io project URL;
# switch to / once the custom domain tipde.online serves this site.
VITE_BASE_PATH=/tipde/
